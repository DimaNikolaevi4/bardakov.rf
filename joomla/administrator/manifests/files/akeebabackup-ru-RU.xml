<?xml version="1.0" encoding="utf-8"?>
<extension type="file" version="1.6" method="upgrade" client="site">
    <name>AkeebaBackupPro - Russian</name>
	<packagename>AkeebaBackup ru-RU</packagename>
	<version>1.1.3</version>	
	
	<creationDate>2023-09</creationDate>
	<author>Russian IT приложения</author>
    <author>Petrov Sergey</author>
    <authorurl>https://tehnoklimat21.ru</authorurl>
	<copyright>Copyright (C) 2023 Russian IT приложения.</copyright>
	<license>GNU GPL v3 or later</license>
    <description>Русификация компонента Akeeba Backup Pro</description>
	<fileset>
	<!-- Раздел копирования основных файлов фронтенда сайта -->
	<!-- Обратите внимание на атрибут folder: этот атрибут описывает папку,
		из которой нужно скопировать файлы из пакета для установки, 
		при этом  эти файлы установщик  Akeeba Backup Pro ru разместит
		в раздел, указанном с помощью target  - 
		файлы копируются из установочного пакета в папку ru-RU. 
		..administrator/components/com_akeebabackup/language/ru-RU
		target="administrator/language/ru-RU"
		<files folder="backend" target="administrator/components/com_akeebabackup/language/ru-RU">
		-->
	<files folder="backend" target="administrator/language/ru-RU">
	<!--В файле [component].ini находятся языковые константы компонента.-->
	<!--В файле [component].sys.ini находятся языковые константы компонента доступные для Joomla.-->
		<filename>ru-RU.com_akeebabackup.sys.ini</filename>
		<filename>ru-RU.com_akeebabackup.ini</filename>
		
		<filename>ru-RU.plg_actionlog_akeebabackup.ini</filename>
		<filename>ru-RU.plg_actionlog_akeebabackup.sys.ini</filename>
		<filename>ru-RU.plg_console_akeebabackup.ini</filename>
		<filename>ru-RU.plg_console_akeebabackup.sys.ini</filename>
		<filename>ru-RU.plg_quickicon_akeebabackup.sys.ini</filename>
		<filename>ru-RU.plg_quickicon_akeebabackup.ini</filename>
		<filename>ru-RU.plg_system_backuponupdate.ini</filename>
		<filename>ru-RU.plg_system_backuponupdate.sys.ini</filename>
		<filename>ru-RU.plg_task_akeebabackup.ini</filename>
		<filename>ru-RU.plg_task_akeebabackup.sys.ini</filename>
		<filename>ru-RU.plg_webservices_akeebabackup.ini</filename>
		<filename>ru-RU.plg_webservices_akeebabackup.sys.ini</filename>		
		
	</files>
	<languages folder="backend">
			<language tag="ru-RU">language/ru-RU/ru-RU.com_akeebabackup.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.com_akeebabackup.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_actionlog_akeebabackup.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_actionlog_akeebabackup.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_console_akeebabackup.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_console_akeebabackup.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_quickicon_akeebabackup.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_quickicon_akeebabackup.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_system_backuponupdate.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_system_backuponupdate.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_task_akeebabackup.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_task_akeebabackup.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_webservices_akeebabackup.ini</language>
			<language tag="ru-RU">language/ru-RU/ru-RU.plg_webservices_akeebabackup.sys.ini</language>
			
	</languages>
	<files folder="frontend" target="language/ru-RU">
		<filename>ru-RU.com_akeebabackup.ini</filename>	
	</files>
	<languages folder="frontend">			
			<language tag="ru-RU">language/ru-RU/ru-RU.com_akeebabackup.ini</language>
	</languages>	
	</fileset>
</extension>
