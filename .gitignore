# ============================================================
# .gitignore для bardakov.rf
# Обновлено: 2026-10-09 (Шаг 5 раздела 1.1.1)
# ============================================================

# --- Тяжелые медиафайлы (хранятся отдельно на хостинге через symlinks) ---
# Доступ через https://сит.бардаков.рф/assets/{video,documents,images}/
# См. docs/large-files-strategy.md
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.rar
*.7z
large-media/

# --- Стандартные исключения Node.js ---
node_modules/
# ⚠️ package-lock.json НЕ исключать — нужен для воспроизводимости CI/CD

# --- Логи ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE и системные файлы ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Eleventy build output ---
public/
.cache/
.eleventy-cache/

# --- Environment ---
.env
.env.local
.env.*.local

# --- Временные файлы ---
*.tmp
*.bak
*.old
