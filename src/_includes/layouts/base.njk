{# base.njk — Базовый layout сайта bardakov.rf
   Источник: design-reference/cit-calck-reference/base.njk (адаптировано)
   Дизайн: design-reference/style.css (палитра «Золотой день / Ночное небо»)
   Создано: 2026-10-10 (Этап E интеграции)

   Особенности:
   - FOUC protection (inline-скрипт в <head>)
   - CSS через preload+onload (async) — пока не используется, стили инлайн
   - JSON-LD Schema.org Person (не EducationalOrganization)
   - Open Graph + Twitter Card
   - Scroll-to-top кнопка
#}
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">

  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">

  {# === SEO: canonical + Open Graph + Twitter Card === #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  {# === Favicon === #}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  {# TODO на Этапе 5.2: полный набор favicons (16, 32, 48, 180, 192, 512) #}

  {# === FOUC protection: тема должна установиться ДО первого рендера === #}
  {# Источник: design-reference/index.html (строки 251-282) #}
  <script>
    (function () {
      const KEY = 'bardakov-theme';
      const root = document.documentElement;
      const body = document.body;
      const allowed = ['light', 'dark', 'high-contrast'];

      function apply(theme) {
        if (!allowed.includes(theme)) theme = 'light';
        if (body) {
          body.setAttribute('data-theme', theme);
        } else {
          root.dataset.pendingTheme = theme;
        }
        document.addEventListener('DOMContentLoaded', function() {
          if (body) body.setAttribute('data-theme', theme);
        });
      }

      let saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      if (saved && allowed.includes(saved)) {
        apply(saved);
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        apply('dark');
      } else {
        apply('light');
      }
    })();
  </script>

  {# === Стили (пока синхронно, Critical CSS добавим на Этапе F) === #}
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/typography.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/a11y.css">
  <link rel="stylesheet" href="/assets/css/components.css">

  {% block head %}{% endblock %}
</head>
<body data-theme="light">

  {# === Skip-link === #}
  <a href="#main" class="skip-link">Перейти к контенту</a>

  {# === Шапка сайта (включает search-modal + offcanvas + a11y-panel) === #}
  {% include "components/header.njk" %}

  {# === Основной контент === #}
  <main id="main" class="site-main" tabindex="-1">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  {# === Подвал сайта === #}
  {% include "components/footer.njk" %}

  {# === Scroll-to-top кнопка === #}
  <a href="#" class="scroll-top" id="scrollTop" aria-label="Наверх" title="Наверх">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5"/>
      <polyline points="5 12 12 5 19 12"/>
    </svg>
  </a>

  {# === JSON-LD: Person (Schema.org) === #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author }}",
    "jobTitle": "{{ site.position }}",
    "worksFor": {
      "@type": "EducationalOrganization",
      "name": "{{ site.organization }}",
      "alternateName": "{{ site.organization_short }}",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{ site.city }}",
        "addressRegion": "{{ site.region }}",
        "addressCountry": "RU"
      }
    },
    "url": "{{ site.url }}",
    "email": "{{ contacts.contacts.email }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{ site.city }}",
      "addressRegion": "{{ site.region }}",
      "addressCountry": "RU"
    }
  }
  </script>

  {# === Yandex.Metrika === #}
  {% if site.metrika_id %}
  <script>
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0];
    k.async=1;k.src=r;a.parentNode.insertBefore(k,a)})
    (window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
    ym({{ site.metrika_id }}, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
  </script>
  <noscript><div><img src="https://mc.yandex.ru/watch/{{ site.metrika_id }}" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  {% endif %}

  {# === JS-модули (с defer — не блокируют рендер) === #}
  <script defer src="/assets/js/theme.js"></script>
  <script defer src="/assets/js/a11y.js"></script>
  <script defer src="/assets/js/main.js"></script>
  <script defer src="/assets/js/offcanvas-nav.js"></script>
  <script defer src="/assets/js/search-modal.js"></script>
</body>
</html>
