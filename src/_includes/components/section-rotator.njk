<div class="section-rotator" data-section-rotator data-start-center="5">
  <div class="section-rotator__stage" role="group" aria-label="Горизонтальная прокрутка карточек 1–6">
    <button
      class="section-rotator__card section-rotator__card--1 is-hidden"
      type="button"
      data-rotator-card="1"
      data-position="is-hidden"
      aria-label="Карточка 1"
      aria-hidden="true"
      aria-disabled="true"
      tabindex="-1"
    >
      <span class="section-rotator__number" aria-hidden="true">1</span>
      <span class="eyebrow visible section-rotator__eyebrow" data-rotator-eyebrow aria-hidden="true">Родился</span>
    </button>
    <button
      class="section-rotator__card section-rotator__card--2 is-hidden"
      type="button"
      data-rotator-card="2"
      data-position="is-hidden"
      aria-label="Карточка 2"
      aria-hidden="true"
      aria-disabled="true"
      tabindex="-1"
    >
      <span class="section-rotator__number" aria-hidden="true">2</span>
      <span class="eyebrow visible section-rotator__eyebrow" data-rotator-eyebrow aria-hidden="true">Учился</span>
    </button>
    <button
      class="section-rotator__card section-rotator__card--3 is-before"
      type="button"
      data-rotator-card="3"
      data-position="is-before"
      aria-label="Карточка 3"
      aria-hidden="true"
      aria-disabled="true"
      tabindex="-1"
    >
      <span class="section-rotator__number" aria-hidden="true">3</span>
      <span class="eyebrow visible section-rotator__eyebrow" data-rotator-eyebrow aria-hidden="true">Женился</span>
    </button>
    <button
      class="section-rotator__card section-rotator__card--4 is-left"
      type="button"
      data-rotator-card="4"
      data-position="is-left"
      aria-label="Карточка 4: Начал работать, слева. Показать предыдущие карточки."
      aria-hidden="false"
      aria-disabled="false"
      tabindex="0"
    >
      <span class="section-rotator__number" aria-hidden="true">4</span>
      <span class="eyebrow visible section-rotator__eyebrow" data-rotator-eyebrow aria-hidden="true">Начал работать</span>
    </button>
    <button
      class="section-rotator__card section-rotator__card--5 is-center"
      type="button"
      data-rotator-card="5"
      data-position="is-center"
      aria-label="Карточка 5: Стал преподавателем, в центре."
      aria-hidden="false"
      aria-disabled="true"
      tabindex="0"
    >
      <span class="section-rotator__number" aria-hidden="true">5</span>
      <span class="eyebrow visible section-rotator__eyebrow" data-rotator-eyebrow aria-hidden="true">Стал преподавателем</span>
    </button>
    <button
      class="section-rotator__card section-rotator__card--6 is-right"
      type="button"
      data-rotator-card="6"
      data-position="is-right"
      aria-label="Карточка 6: В будущем, справа. Показать следующие карточки."
      aria-hidden="false"
      aria-disabled="false"
      tabindex="0"
    >
      <span class="section-rotator__number" aria-hidden="true">6</span>
      <span class="eyebrow visible section-rotator__eyebrow" data-rotator-eyebrow aria-hidden="true">В будущем</span>
    </button>
  </div>

  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-rotator-status>
    Показаны карточки 4 — Начал работать, 5 — Стал преподавателем и 6 — В будущем.
  </p>
</div>
