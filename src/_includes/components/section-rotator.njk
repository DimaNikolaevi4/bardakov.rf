<div class="section-rotator" data-section-rotator data-start-center="5">
  <div class="section-rotator__stage" role="group" aria-label="Горизонтальная прокрутка карточек 1–6">
    <button
      class="section-rotator__card section-rotator__card--1 is-hidden"
      type="button"
      data-rotator-card="1"
      data-position="is-hidden"
      aria-label="Карточка 1"
      aria-hidden="true"
      aria-disabled="true"
      tabindex="-1"
    >1</button>
    <button
      class="section-rotator__card section-rotator__card--2 is-hidden"
      type="button"
      data-rotator-card="2"
      data-position="is-hidden"
      aria-label="Карточка 2"
      aria-hidden="true"
      aria-disabled="true"
      tabindex="-1"
    >2</button>
    <button
      class="section-rotator__card section-rotator__card--3 is-before"
      type="button"
      data-rotator-card="3"
      data-position="is-before"
      aria-label="Карточка 3"
      aria-hidden="true"
      aria-disabled="true"
      tabindex="-1"
    >3</button>
    <button
      class="section-rotator__card section-rotator__card--4 is-left"
      type="button"
      data-rotator-card="4"
      data-position="is-left"
      aria-label="Карточка 4, слева. Показать предыдущие карточки."
      aria-hidden="false"
      aria-disabled="false"
      tabindex="0"
    >4</button>
    <button
      class="section-rotator__card section-rotator__card--5 is-center"
      type="button"
      data-rotator-card="5"
      data-position="is-center"
      aria-label="Карточка 5, в центре."
      aria-hidden="false"
      aria-disabled="true"
      tabindex="0"
    >5</button>
    <button
      class="section-rotator__card section-rotator__card--6 is-right"
      type="button"
      data-rotator-card="6"
      data-position="is-right"
      aria-label="Карточка 6, справа. Показать следующие карточки."
      aria-hidden="false"
      aria-disabled="false"
      tabindex="0"
    >6</button>
  </div>

  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-rotator-status>
    Показаны карточки 4, 5 и 6 из 1–6.
  </p>
</div>
