{# nav-burger.njk — Offcanvas мобильное меню
   Источник: old/DESIGN.md §6 + old/new-stack/site/assets/components/header.html
   Создано: 2026-10-09 (Этап 3.2)
   Доступность: aria-expanded, aria-controls, закрытие по Esc, фокус-ловушка
#}

{# Backdrop #}
<div class="offcanvas-backdrop" id="offcanvasBackdrop" aria-hidden="true"></div>

{# Сам offcanvas #}
<aside class="offcanvas" id="offcanvasNav" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="offcanvasNavLabel" aria-hidden="true">
  <div class="offcanvas-header">
    <a href="/" class="offcanvas-brand" data-dismiss="offcanvas">
      <img src="/favicon.ico" alt="" class="header-logo-img" width="28" height="28">
      <span class="offcanvas-title" id="offcanvasNavLabel">{{ site.footerText }}</span>
    </a>
    <button type="button" class="close-btn offcanvas-dismiss" aria-label="Закрыть меню" data-dismiss="offcanvas">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  </div>

  <div class="offcanvas-body">
    <nav class="offcanvas-nav" aria-label="Разделы сайта">

      {% for item in navigation.main_menu %}
      {% if item.submenu %}
      <button type="button"
              class="offcanvas-nav-link offcanvas-parent"
              data-oc-title="{{ item.title }}"
              data-oc-target="ocSub{{ loop.index }}">
        <i class="bi {{ item.icon }}" aria-hidden="true"></i>
        <span>{{ item.title }}</span>
        <i class="bi bi-chevron-right offcanvas-arrow" aria-hidden="true"></i>
      </button>
      {% else %}
      <a href="{{ item.url }}" class="offcanvas-nav-link" data-dismiss="offcanvas">
        <i class="bi {{ item.icon }}" aria-hidden="true"></i>
        <span>{{ item.title }}</span>
      </a>
      {% endif %}
      {% endfor %}

      {# Поиск #}
      <a href="/search/" class="offcanvas-nav-link" data-dismiss="offcanvas">
        <i class="bi bi-search" aria-hidden="true"></i>
        <span>Поиск</span>
      </a>
    </nav>
  </div>
</aside>

{# Боковая панель для подменю (выезжает рядом) #}
<aside class="offcanvas offcanvas-side" id="offcanvasSide" aria-hidden="true">
  <div class="offcanvas-header">
    <button type="button" class="offcanvas-back-btn" aria-label="Назад">
      <i class="bi bi-chevron-left" aria-hidden="true"></i>
      <span id="offcanvasSideTitle"></span>
    </button>
    <button type="button" class="close-btn" aria-label="Закрыть" data-dismiss="offcanvas-side">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  </div>
  <div class="offcanvas-body">
    <nav class="offcanvas-nav" id="offcanvasSideNav" aria-label="Подменю"></nav>
  </div>
</aside>
