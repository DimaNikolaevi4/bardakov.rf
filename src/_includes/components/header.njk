{# header.njk — Шапка сайта bardakov.rf
   Источник: design-reference/cit-calck-reference/header.njk (адаптировано)
   Дизайн: design-reference/style.css (палитра «Золотой день / Ночное небо»)
   Создано: 2026-10-10 (Этап B интеграции)

   Особенности:
   - Sticky с backdrop-filter: blur(14px)
   - Монограмма «БД» в градиентном квадрате (из design-reference)
   - 4 пункта главного меню с компактными тематическими иконками
   - Быстрые действия: почта / поиск / доступность / тема
   - Кнопка «Все разделы» (offcanvas-toggle)
   - Бургер для мобильных
#}
<header id="site-header" class="site-header" data-site-header>
  <div class="container nav-wrapper">

    {# === Логотип — графический знак (SVG из фавикона, без текста) === #}
    <a href="/" class="logo" aria-label="Бардаков Д. Н. — персональный сайт, на главную">
      <svg class="logo-mark" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
        <g fill="currentColor" stroke="currentColor" stroke-linecap="round">
          <circle cx="20" cy="20" r="9" stroke="none"/>
          <rect x="10" y="33" width="20" height="53" rx="8" stroke="none"/>
          <path d="M26 45 L42 36" stroke-width="8" fill="none"/>
          <path d="M42 36 L66 23" stroke-width="4.5" fill="none"/>
          <rect x="40" y="4" width="52" height="9" rx="2" stroke="none"/>
          <rect x="45" y="13" width="42" height="50" rx="2" fill="none" stroke-width="7"/>
          <path d="M66 66 L54 90 M66 66 L78 90" stroke-width="7" fill="none"/>
        </g>
      </svg>
    </a>

    {# === Десктоп-навигация (≥992px) === #}
    <nav class="main-nav hidden-md-down" aria-label="Основная навигация">
      <ul class="main-nav-list">
        {% for item in menu.main %}
        <li class="main-nav-item">
          <a href="{{ item.url }}"
             class="main-nav-link"
             {% if page.url == item.url %}aria-current="page"{% endif %}>
            <i class="bi main-nav-icon{% if item.key == 'about' %} bi-person-vcard{% elseif item.key == 'education' %} bi-journal-bookmark{% elseif item.key == 'abiturient' %} bi-mortarboard{% elseif item.key == 'vospitanie' %} bi-heart-pulse{% endif %}" aria-hidden="true"></i>
            <span>{{ item.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    {# === Иконки действий === #}
    <div class="header-actions">
      {# MAX мессенджер #}
      <a href="https://max.ru/join/pzpeTfp5807aifjz7d1_MAmy6Ksa6ffcXMK5EoYOsAY"
         class="header-icon-btn"
         target="_blank"
         rel="noopener"
         title="Написать в MAX"
         aria-label="Мессенджер MAX">
        <i class="bi bi-chat" aria-hidden="true"></i>
      </a>

      {# Email #}
      <a href="mailto:{{ contacts.contacts.email }}"
         class="header-icon-btn"
         title="Написать на почту: {{ contacts.contacts.email }}"
         aria-label="Электронная почта">
        <i class="bi bi-envelope" aria-hidden="true"></i>
      </a>

      {# Поиск #}
      <button type="button"
              class="header-icon-btn"
              id="headerSearchToggle"
              title="Поиск по сайту"
              aria-label="Поиск"
              aria-expanded="false"
              aria-controls="searchModal">
        <i class="bi bi-search" aria-hidden="true"></i>
      </button>

      {# A11y #}
      <button type="button"
              class="header-icon-btn"
              id="a11yToggle"
              title="Настройки доступности"
              aria-label="Настройки доступности"
              aria-expanded="false"
              aria-controls="a11yPanel">
        <i class="bi bi-eye" aria-hidden="true"></i>
      </button>

      {# Theme switcher (3 кнопки) #}
      <div class="theme-switcher" role="group" aria-label="Выбор темы оформления">
        <button type="button" class="theme-btn" data-theme="light" aria-label="Светлая тема" title="Светлая тема" aria-pressed="true">
          <i class="bi bi-sun" aria-hidden="true"></i>
        </button>
        <button type="button" class="theme-btn" data-theme="dark" aria-label="Тёмная тема" title="Тёмная тема" aria-pressed="false">
          <i class="bi bi-moon-stars" aria-hidden="true"></i>
        </button>
        <button type="button" class="theme-btn" data-theme="high-contrast" aria-label="Версия для слабовидящих" title="Версия для слабовидящих" aria-pressed="false">
          <i class="bi bi-circle-half" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    {# Отдельный десктопный контроль всех разделов #}
    <button type="button"
            class="header-icon-btn rubrics-toggle hidden-md-down"
            id="offcanvasToggle"
            title="Все разделы сайта"
            aria-label="Все разделы"
            aria-expanded="false"
            aria-controls="offcanvasRubrics">
      <i class="bi bi-list-nested" aria-hidden="true"></i>
    </button>

    {# Бургер для компактной навигации #}
    <button type="button"
            class="header-icon-btn burger hidden-lg-up"
            id="burgerBtn"
            aria-label="Открыть меню"
            title="Меню"
            aria-expanded="false"
            aria-controls="offcanvasRubrics">
      <i class="bi bi-list" aria-hidden="true"></i>
    </button>

  </div>
</header>

{# === Search Modal (Этап C) === #}
{% include "components/search-modal.njk" %}

{# === Offcanvas 3-уровневый (Этап D) === #}
{% include "components/offcanvas.njk" %}

{# === A11y Panel === #}
{% include "components/a11y-panel.njk" %}

{# === Данные рубрик для offcanvas-nav.js === #}
<script id="rubricsData" type="application/json">{{ rubrics.main_rubrics | dump | safe }}</script>
