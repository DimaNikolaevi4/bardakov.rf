{# offcanvas.njk — 3-уровневое offcanvas-меню
   Источник: design-reference/cit-calck-reference/header.njk (строки 188–380)
   Создано: 2026-10-10 (Этап D интеграции)

   3 панели:
   - Панель 1 (#ocPanel1): список рубрик 1-го уровня + иконки действий (мобильные)
   - Панель 2 (#ocPanel2): подразделы (заполняется через JS)
   - Панель 3 (#ocPanel3): под-подразделы (заполняется через JS)
#}

{# === Backdrop === #}
<div class="offcanvas-backdrop" id="offcanvasBackdrop" aria-hidden="true"></div>

{# === Панель 1 — 1-й уровень (справа) === #}
<aside class="offcanvas" id="offcanvasRubrics" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="offcanvasRubricsLabel" aria-hidden="true">

  {# Заголовок #}
  <div class="offcanvas-header">
    <a href="/" class="offcanvas-brand" data-dismiss="offcanvas" title="На главную">
      <span class="logo-mark" aria-hidden="true">БД</span>
      <span class="offcanvas-title-wrap">
        <span class="offcanvas-title" id="offcanvasRubricsLabel">Разделы сайта</span>
        <span class="offcanvas-subtitle">Бардаков Д. Н.</span>
      </span>
    </a>
    <button type="button" class="close-btn offcanvas-dismiss" aria-label="Закрыть меню" data-dismiss="offcanvas">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {# Тело #}
  <div class="offcanvas-body">
    <div class="oc-panel" id="ocPanel1">
      <div class="oc-panel__scroll">

        {# Иконки действий — только на мобильных (< 992px) #}
        <div class="offcanvas-actions hidden-lg-up">
          <a href="mailto:{{ contacts.contacts.email }}"
             class="header-icon-btn"
             title="Написать на почту: {{ contacts.contacts.email }}"
             aria-label="Электронная почта">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
          <button class="header-icon-btn" id="offcanvasSearchToggle" type="button" title="Поиск по сайту" aria-label="Поиск">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
          <button class="header-icon-btn" type="button" id="offcanvasA11yToggle" title="Версия для слабовидящих" aria-label="Версия для слабовидящих">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
          <button class="header-icon-btn" id="offcanvasThemeToggle" type="button" title="Тёмная тема" aria-label="Тёмная / светлая тема">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>

        {# Метка секции #}
        <div class="offcanvas-section-label">
          <span>Все разделы</span>
        </div>

        {# Список рубрик 1-го уровня #}
        <nav class="oc-nav" aria-label="Разделы сайта">
          {% for item in rubrics.main_rubrics %}
            {% set sectionUrl = '/' + item.slug + '/' %}
            {% if item.url %}
              {% set sectionUrl = item.url %}
            {% endif %}
            {% set isActiveSection = page.url | startsWith(sectionUrl) %}
            {% if item.children %}
              <div class="oc-split-row{% if isActiveSection %} is-active{% endif %}" data-rubric-index="{{ loop.index0 }}">
                <a href="{{ sectionUrl }}"
                   class="oc-split-row__link oc-dismiss-all{% if isActiveSection %} active{% endif %}"
                   title="{{ item.title }}"
                   {% if isActiveSection %}aria-current="page"{% endif %}>
                  <span>{{ item.title }}</span>
                </a>
                <button class="oc-split-row__toggle"
                        type="button"
                        aria-label="Открыть подразделы: {{ item.title }}"
                        aria-expanded="false"
                        data-rubric-index="{{ loop.index0 }}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </button>
              </div>
            {% else %}
              <a href="{{ sectionUrl }}"
                 class="oc-split-row__link oc-split-row__link--leaf oc-dismiss-all{% if isActiveSection %} active{% endif %}"
                 title="{{ item.title }}"
                 {% if isActiveSection %}aria-current="page"{% endif %}>
                <span>{{ item.title }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </nav>

        {# Подвал offcanvas #}
        <div class="oc-footer">
          <a href="/obo-mne/kontakty/" class="oc-footer__link" data-dismiss="offcanvas">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{{ contacts.person.city }}, {{ contacts.person.region }}</span>
          </a>
          <a href="mailto:{{ contacts.contacts.email }}" class="oc-footer__email">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>{{ contacts.contacts.email_display }}</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</aside>

{# === Панель 2 — 2-й уровень (заполняется через JS) === #}
<aside class="oc-side-panel" id="ocPanel2" aria-hidden="true">
  <div class="oc-side-panel__header">
    <div class="oc-panel-header-main">
      <div class="oc-panel-breadcrumb-row">
        <button class="oc-back-btn" id="ocBackBtn2" type="button" aria-label="Назад">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          <span class="oc-panel-breadcrumb" id="ocPanel2Breadcrumb">Разделы сайта</span>
        </button>
      </div>
      <span class="oc-side-panel__title" id="ocPanel2Title"></span>
    </div>
    <button class="close-btn oc-close-btn" id="ocCloseBtn2" type="button" aria-label="Закрыть">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <div class="oc-panel__scroll" id="ocPanel2Scroll">
    <a class="oc-panel-open-link" id="ocPanel2OpenLink" href="#">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
      Открыть весь раздел
    </a>
    <nav aria-label="Подразделы">
      <ul class="oc-sub-list" id="ocSubList"></ul>
    </nav>
  </div>
</aside>

{# === Панель 3 — 3-й уровень (заполняется через JS) === #}
<aside class="oc-side-panel" id="ocPanel3" aria-hidden="true">
  <div class="oc-side-panel__header">
    <div class="oc-panel-header-main">
      <div class="oc-panel-breadcrumb-row">
        <button class="oc-back-btn" id="ocBackBtn3" type="button" aria-label="Назад">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          <span class="oc-panel-breadcrumb" id="ocPanel3Breadcrumb"></span>
        </button>
      </div>
      <span class="oc-side-panel__title" id="ocPanel3Title"></span>
    </div>
    <button class="close-btn oc-close-btn" id="ocCloseBtn3" type="button" aria-label="Закрыть">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <div class="oc-panel__scroll" id="ocPanel3Scroll">
    <a class="oc-panel-open-link" id="ocPanel3OpenLink" href="#">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
      Открыть весь раздел
    </a>
    <nav aria-label="Под-подразделы">
      <ul class="oc-sub-list" id="ocSubSubList"></ul>
    </nav>
  </div>
</aside>
