<section
  class="home-carousel home-carousel--showcase"
  data-home-carousel
  aria-label="Фотографии сайта"
  aria-roledescription="карусель"
  aria-live="polite"
>
  <div class="home-carousel__slides">
    <article
      class="home-carousel__slide is-active"
      aria-roledescription="слайд"
      aria-label="1 из 3"
      aria-hidden="false"
    >
      <img
        class="home-carousel__image"
        src="/assets/images/home-slider/profile.jpeg"
        alt="Дмитрий Николаевич Бардаков в своём кабинете"
        fetchpriority="high"
        decoding="async"
      >
    </article>

    <article
      class="home-carousel__slide"
      aria-roledescription="слайд"
      aria-label="2 из 3"
      aria-hidden="true"
      inert
    >
      <img
        class="home-carousel__image"
        src="/assets/images/home-slider/education.jpg"
        alt="Студенты за совместной работой в аудитории"
        loading="lazy"
        decoding="async"
      >
    </article>

    <article
      class="home-carousel__slide"
      aria-roledescription="слайд"
      aria-label="3 из 3"
      aria-hidden="true"
      inert
    >
      <img
        class="home-carousel__image"
        src="/assets/images/home-slider/teaching.jpg"
        alt="Преподаватель показывает студентам учебный электрический стенд"
        loading="lazy"
        decoding="async"
      >
    </article>
  </div>

  <div class="home-carousel__controls" role="group" aria-label="Управление слайдером">
    <button
      class="home-carousel__arrow home-carousel__arrow--previous"
      type="button"
      data-carousel-previous
      aria-label="Предыдущий слайд"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button
      class="home-carousel__arrow home-carousel__arrow--next"
      type="button"
      data-carousel-next
      aria-label="Следующий слайд"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
    <div class="home-carousel__pagination" role="group" aria-label="Выбрать слайд">
      <button class="home-carousel__dot" type="button" data-carousel-slide="0" aria-label="Показать фотографию 1" aria-current="true"></button>
      <button class="home-carousel__dot" type="button" data-carousel-slide="1" aria-label="Показать фотографию 2" aria-current="false"></button>
      <button class="home-carousel__dot" type="button" data-carousel-slide="2" aria-label="Показать фотографию 3" aria-current="false"></button>
    </div>
  </div>
</section>
