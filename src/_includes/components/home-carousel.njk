{# home-carousel.njk — Веерная карусель с blob-формой
   Источник: docs/DESIGN.md §6 + креативный дизайн (fan layout, blob-morph)
   Создано: 2026-10-18 (fan carousel + dynamic text)

   Особенности:
   - Веерная раскладка: все 3 слайда видны одновременно (левый, центральный, правый)
   - Blob-форма для фото (CSS-анимация morph 12s)
   - Нет фонового квадрата/контейнера вокруг слайдера
   - Нет оверлеев с текстом на слайдах
   - Текст меняется в левом блоке (.page-showcase__copy) через JS
   - Автопрокрутка 8s, задержка запуска 3s
   - Пауза при наведении мыши
#}
<section
  class="home-carousel home-carousel--showcase"
  data-home-carousel
  aria-label="Фотографии сайта"
  aria-roledescription="карусель"
  aria-live="polite"
>
  {# Точки пагинации — сверху справа #}
  <div class="home-carousel__pagination" role="group" aria-label="Выбрать слайд">
    <button class="home-carousel__dot" type="button" data-carousel-slide="0" aria-label="Показать слайд 1" aria-current="true"></button>
    <button class="home-carousel__dot" type="button" data-carousel-slide="1" aria-label="Показать слайд 2" aria-current="false"></button>
    <button class="home-carousel__dot" type="button" data-carousel-slide="2" aria-label="Показать слайд 3" aria-current="false"></button>
  </div>

  <div class="home-carousel__slides">
    {# Слайд 1: Обо мне (активный) #}
    <article
      class="home-carousel__slide is-active"
      aria-roledescription="слайд"
      aria-label="1 из 3"
      aria-hidden="false"
      data-slide="0"
    >
      <img
        class="home-carousel__image"
        src="/assets/images/home-slider/profile.jpeg"
        alt="Дмитрий Николаевич Бардаков в своём кабинете"
        fetchpriority="high"
        decoding="async"
      >
    </article>

    {# Слайд 2: Воспитание (следующий) #}
    <article
      class="home-carousel__slide is-next"
      aria-roledescription="слайд"
      aria-label="2 из 3"
      aria-hidden="true"
      data-slide="1"
    >
      <img
        class="home-carousel__image"
        src="/assets/images/home-slider/education.jpg"
        alt="Студенты за совместной работой в аудитории"
        loading="lazy"
        decoding="async"
      >
    </article>

    {# Слайд 3: Обучение (предыдущий) #}
    <article
      class="home-carousel__slide is-prev"
      aria-roledescription="слайд"
      aria-label="3 из 3"
      aria-hidden="true"
      data-slide="2"
    >
      <img
        class="home-carousel__image"
        src="/assets/images/home-slider/teaching.jpg"
        alt="Преподаватель показывает студентам учебный электрический стенд"
        loading="lazy"
        decoding="async"
      >
    </article>
  </div>

  {# Стрелки управления — снизу по центру #}
  <div class="home-carousel__controls" role="group" aria-label="Управление слайдером">
    <button
      class="home-carousel__arrow home-carousel__arrow--previous"
      type="button"
      data-carousel-previous
      aria-label="Предыдущий слайд"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button
      class="home-carousel__arrow home-carousel__arrow--next"
      type="button"
      data-carousel-next
      aria-label="Следующий слайд"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>
</section>
